{
  "name": "@local/dsh-meetrecord",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "党务工作助手：三会一课、支委会、党员大会、党课、组织生活会、发展党员、选举、党费材料与会议记录；兼顾机关其他工作性质，支持 Word 导出与 Obsidian 知识库。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/*.js",
    "README.md",
    "skills/*/*.md",
    "seed/*/*.md",
    "skills/*/references/*.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JerryYan-yus/dsh-meeting-record.git"
  },
  "homepage": "https://github.com/JerryYan-yus/dsh-meeting-record",
  "bugs": {
    "url": "https://github.com/JerryYan-yus/dsh-meeting-record/issues"
  }
}
